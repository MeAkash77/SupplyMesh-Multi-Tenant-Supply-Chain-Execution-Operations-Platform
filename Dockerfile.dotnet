# docker build -f Dockerfile.dotnet --build-arg PROJECT=SupplyMesh.Orders.Api -t supplymesh/orders-api .
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG PROJECT
WORKDIR /src
COPY src/ src/
RUN dotnet publish src/${PROJECT}/${PROJECT}.csproj -c Release -o /out
FROM mcr.microsoft.com/dotnet/aspnet:8.0
ARG PROJECT
ENV PROJECT_DLL=${PROJECT}.dll ASPNETCORE_URLS=http://+:8080
WORKDIR /app
COPY --from=build /out .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh","-c","dotnet $PROJECT_DLL"]
